{
  "Kubernetes": {
    "Namespace": "overlay-fixture-staging",
    "Images": {
      "Tag": "v0.0.0-fixture"
    },
    "EnvironmentVariables": {
      "Shared": {
        "DOTNET_ENVIRONMENT": "Staging",
        "ASPNETCORE_ENVIRONMENT": "Staging"
      }
    },
    "Ingress": {
      "CertClusterIssuerName": "fixture-issuer",
      "Resources": {
        "overlay": {
          "overlay-ingress-http": {
            "Host": "overlay.fixture.invalid",
            "TlsSecretName": "overlay-fixture-tls-staging"
          }
        }
      }
    }
  }
}
