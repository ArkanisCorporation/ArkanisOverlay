{
  "Kubernetes": {
    "Namespace": "arkanis-overlay-production",
    "Images": {
      "Tag": "stable-latest"
    },
    "EnvironmentVariables": {
      "Shared": {
        "DOTNET_ENVIRONMENT": "Production",
        "ASPNETCORE_ENVIRONMENT": "Production"
      }
    },
    "Ingress": {
      "CertClusterIssuerName": "letsencrypt-production",
      "Resources": {
        "overlay": {
          "overlay-ingress-http": {
            "Host": "overlay.arkanis.space",
            "TlsSecretName": "overlay-tls-production"
          }
        }
      }
    }
  }
}
