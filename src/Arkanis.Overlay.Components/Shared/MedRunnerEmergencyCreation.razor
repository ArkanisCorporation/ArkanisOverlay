@using System.Diagnostics.CodeAnalysis
@using Arkanis.Overlay.Domain.Abstractions
@using Arkanis.Overlay.Domain.Abstractions.Game
@using Arkanis.Overlay.External.MedRunner.API.Abstractions
@using Arkanis.Overlay.External.MedRunner.API.Endpoints.Emergency.Request
@using Arkanis.Overlay.External.MedRunner.Models
@using Arkanis.Overlay.Infrastructure.Helpers
@inherits MedRunnerComponentBase
@inject IMedRunnerClientConfig MedRunnerClientConfig

<MudGrid Class="pa-5" Spacing="3">
    <MudItem xs="12" sm="6">
        <GameEntitySelectBox
            Label="System"
            Placeholder="Select the current star system"
            EntityCategory="@GameEntityCategory.Location"
            Value="@_selectedSystemEntity"
            ValueChanged="@OnSystemChanged"
            Accept="@(location => location is GameStarSystem system && MedRunnerEmergencyLocation.SupportsSystem(system, ServiceContext.PublicSettings.LocationSettings))"
            Clearable="true"
            Required/>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudStack Spacing="0">
            <GameEntitySelectBox
                Label="Orbit / Planet / Moon"
                Placeholder="Search for the closest planet or moon"
                EntityCategory="@GameEntityCategory.Location"
                Value="@_selectedPlanetOrMoonEntity"
                ValueChanged="@OnPlanetOrMoonChanged"
                Accept="@(location => location is GameLocationEntity gameLocation and (GamePlanet or GameMoon)
                                      && SelectedSystem?.Contains(gameLocation) == true
                                      && MedRunnerEmergencyLocation.Resolve(gameLocation, ServiceContext.PublicSettings.LocationSettings) is not null)"
                Disabled="@(SelectedSystem is null)"
                Clearable="true"
                Required/>

            @if (LocationSelection is { } selection)
            {
                <MudText Typo="@Typo.body2" Class="mb-2">
                    <span class="text-secondary">Rescue area:</span>
                    <span>
                        @string.Join(" / ", LocationNames(selection))
                    </span>
                </MudText>
            }
        </MudStack>
    </MudItem>
    <MudItem xs="12" md="8">
        <GameEntitySelectBox
            Label="Closest location"
            Placeholder="Search for a closest game location"
            HelperText="Not required, only provide if you know the exact location closest to you"
            EntityCategory="@GameEntityCategory.Location"
            @bind-Value="@_selectedLocationEntity"
            Disabled="@(SelectedPlanet is null)"
            Accept="@(location => location is IGameLocation gameLocation and (GameCity or GameOutpost or GameTerminal or GamePointOfInterest or GameSpaceStation)
                                  && SelectedPlanetOrMoon?.Contains(gameLocation) == true)"
            Clearable="true"/>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudSelect @bind-Value="@_threatLevel"
                   Label="Threat level"
                   Required>
            @foreach (var threatLevel in Enum.GetValues<ThreatLevel>())
            {
                <MudSelectItem T="ThreatLevel?" Value="@threatLevel">
                    @threatLevel.Humanize()
                </MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12">
        <MudStack Spacing="3">
            @if (LocationSelection is null && (_selectedPlanetOrMoonEntity is not null || ServiceContext.PublicSettings.LocationSettings.Locations.Count == 0))
            {
                <MudAlert Severity="@Severity.Warning">
                    Select an enabled system and planet supported by Medrunner before submitting a request.
                </MudAlert>
            }

            @if (MedRunnerClientConfig.IsMock)
            {
                <MudAlert Severity="@Severity.Warning">
                    The Medrunner API is currently in local mock mode.
                    Submitting this request will will not contact the live Medrunner API.
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="@Severity.Info">
                    By submitting this request to this <b>live</b> service, you agree to the
                    <MudLink Href="@ExternalLinkHelper.GetMedRunnerTosLink(ContentId)"
                             Target="_blank"
                             Typo="@Typo.inherit">
                        terms and conditions
                    </MudLink>
                    of the service provider.
                </MudAlert>
            }
        </MudStack>
    </MudItem>
    <MudItem xs="12">
        @if (!ServiceContext.ServiceAccessState.CanUseServices)
        {
            <MudAlert Severity="@Severity.Error" Class="mb-2">
                <b>Medrunner services unavailable.</b>
                @ServiceContext.ServiceAccessState.Message
            </MudAlert>
        }
        <MudButton Variant="@Variant.Filled"
                   Color="@Color.Error"
                   Class="w-100"
                   StartIcon="@Icons.Material.Filled.EmergencyShare"
                   OnClick="@StartMedRunnerEmergencyAsync"
                   Disabled="@SubmitDisabled">
            Submit request
        </MudButton>
        @if (EmergencyContext.HasErrors)
        {
            <MudStack Class="mt-2">
                @foreach (var error in EmergencyContext.Errors)
                {
                    <MudAlert Severity="@Severity.Error">
                        @error
                    </MudAlert>
                }
            </MudStack>
        }
    </MudItem>
</MudGrid>

@code
{

    private ThreatLevel? _threatLevel;
    private IGameEntity? _selectedLocationEntity;
    private IGameEntity? _selectedSystemEntity;
    private IGameEntity? _selectedPlanetOrMoonEntity;

    private IGameLocation? SelectedSystem
        => _selectedSystemEntity as IGameLocation;

    private IGameLocation? SelectedPlanet
        => _selectedPlanetOrMoonEntity is GameMoon moon
            ? moon.Parent
            : _selectedPlanetOrMoonEntity as IGameLocation;

    private IGameLocation? SelectedPlanetOrMoon
        => _selectedPlanetOrMoonEntity as IGameLocation;

    private GameLocationEntity? ClosestLocation
        => _selectedLocationEntity as GameLocationEntity
           ?? SelectedPlanetOrMoon as GameLocationEntity;

    private MedRunnerEmergencyLocationSelection? LocationSelection
        => ClosestLocation is { } closest
           && SelectedPlanetOrMoon is { } planetOrMoon
           && SelectedSystem?.Contains(planetOrMoon) == true
           && planetOrMoon.IsOrContains(closest)
            ? MedRunnerEmergencyLocation.Resolve(closest, ServiceContext.PublicSettings.LocationSettings)
            : null;

    private Task OnSystemChanged(IGameEntity? system)
    {
        if (IIdentifiable.EqualityComparer.Default.Equals(_selectedSystemEntity, system))
        {
            return Task.CompletedTask;
        }

        _selectedSystemEntity = system;
        _selectedPlanetOrMoonEntity = null;
        _selectedLocationEntity = null;
        return Task.CompletedTask;
    }

    private Task OnPlanetOrMoonChanged(IGameEntity? planetOrMoon)
    {
        if (IIdentifiable.EqualityComparer.Default.Equals(_selectedPlanetOrMoonEntity, planetOrMoon))
        {
            return Task.CompletedTask;
        }

        _selectedPlanetOrMoonEntity = planetOrMoon;
        _selectedLocationEntity = null;
        return Task.CompletedTask;
    }

    [MemberNotNullWhen(false, nameof(ClosestLocation), nameof(_threatLevel))]
    private bool SubmitDisabled
        => IsLoading
           || !ServiceContext.ServiceAccessState.CanUseServices
           || ClosestLocation is null
           || LocationSelection is null
           || _threatLevel is null;

    private async Task StartMedRunnerEmergencyAsync()
    {
        if (SubmitDisabled)
        {
            return;
        }

        await PerformSafeAsync(async () =>
            {
                if (LocationSelection is not { } selection || !ServiceContext.ServiceAccessState.CanUseServices)
                {
                    EmergencyContext.Errors.Add("The selected location is no longer supported by Medrunner. Select an enabled system and planet.");
                    await EmergencyContextChanged.InvokeAsync(EmergencyContext);
                    return;
                }

                var request = new CreateEmergencyRequest
                {
                    Location = selection.Location,
                    ThreatLevel = _threatLevel.Value,
                    Remarks = selection.Remarks,
                };
                var accountGeneration = ServiceContext.AccountGeneration;
                var emergencyResponse = await Medrunner.Emergency.CreateEmergencyAsync(request);
                if (accountGeneration != ServiceContext.AccountGeneration)
                {
                    return;
                }

                if (!emergencyResponse.Success)
                {
                    EmergencyContext.Errors.Add(emergencyResponse.ErrorMessage);
                    await EmergencyContextChanged.InvokeAsync(EmergencyContext);
                    return;
                }

                EmergencyContext.Emergency = emergencyResponse.Data;
                ServiceContext.RecordEmergency(emergencyResponse.Data);
                EmergencyContext.DetailsDefaults = new EmergencyDetailsDefaults(emergencyResponse.Data.Id, selection.ExactLocation, selection.LocationType, selection.Remarks);
                await EmergencyContextChanged.InvokeAsync(EmergencyContext);
            }
        );
    }

    private static IEnumerable<string?> LocationNames(MedRunnerEmergencyLocationSelection selection)
    {
        return new[] { selection.Location.System, selection.Location.Subsystem, selection.Location.TertiaryLocation }.Where(name => name is not null);
    }

}
